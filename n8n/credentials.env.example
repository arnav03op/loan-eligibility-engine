# Copy to n8n/credentials.env (gitignored). Read ONLY by scripts/make-n8n-credentials.py,
# which turns it into n8n credentials. These values are never passed to the container env.

# Local development database (dev-db container). scripts/use-rds-in-n8n.sh switches these to RDS
# (see README, "Configure n8n").
PG_HOST=dev-db
PG_PORT=5432
PG_DATABASE=loan_engine
PG_USER=loan
PG_PASSWORD=loan
PG_SSL=disable

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# IAM user limited to ses:SendEmail (scripts/create-ses-user.sh fills these in; see README, "AWS account and SES").
AWS_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
