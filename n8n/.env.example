# Copy to n8n/.env (gitignored). Everything here becomes an environment variable
# inside the n8n container and is readable from workflow expressions via $env.

# Pinned to the versions tested (see README, "Local prerequisites").
N8N_VERSION=2.42.4
CLOUDFLARED_VERSION=2026.10.0

# Encrypts n8n's stored credentials. Generate once: openssl rand -hex 32 — never change it.
N8N_ENCRYPTION_KEY=

# Must equal SSM /loan-engine/webhook-secret (scripts/sync-n8n-secret.sh copies it in; see README, "Deploy the AWS stack").
WEBHOOK_SECRET=

GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_CALLS=20
NOTIFY_MAX_EMAILS=5

# Your own Gmail + aliases. Every notification goes to these, never to CSV addresses.
TEST_INBOX_ALIASES=yourgmail+one@gmail.com,yourgmail+two@gmail.com
SES_FROM=yourgmail@gmail.com
ADMIN_ALIAS=yourgmail+alerts@gmail.com
