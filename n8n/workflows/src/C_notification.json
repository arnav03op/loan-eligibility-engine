{
  "id": "loanEngineWfC001",
  "name": "C · User Notification",
  "active": false,
  "settings": { "executionOrder": "v1", "errorWorkflow": "loanEngineWfE001", "timezone": "Asia/Kolkata" },
  "nodes": [
    {
      "id": "c0000000-0000-4000-8000-000000000001",
      "name": "From matching workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "c0000000-0000-4000-8000-000000000002",
      "name": "Run manually (latest batch)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "c0000000-0000-4000-8000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 100],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "c2000000-0000-4000-8000-000000000001", "name": "notify_max_emails", "value": "={{ Number($env.NOTIFY_MAX_EMAILS || 5) }}", "type": "number" },
            { "id": "c2000000-0000-4000-8000-000000000002", "name": "test_inbox_aliases", "value": "={{ $env.TEST_INBOX_ALIASES }}", "type": "string" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000004",
      "name": "Build pending SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 100],
      "parameters": { "jsCode": "@@code:c_build_pending_sql.js" }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000005",
      "name": "Fetch users to notify",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 100],
      "parameters": { "operation": "executeQuery", "query": "={{ $json.sql }}", "options": {} },
      "credentials": { "postgres": { "id": "loanEngPostgres01", "name": "Loan Engine Postgres" } }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000006",
      "name": "Build emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 100],
      "parameters": { "jsCode": "@@code:c_build_emails.js" }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000007",
      "name": "Loop over emails",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1100, 100],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000008",
      "name": "Send via SES",
      "type": "n8n-nodes-base.awsSes",
      "typeVersion": 1,
      "position": [1320, 200],
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "send",
        "isBodyHtml": true,
        "subject": "={{ $json.subject }}",
        "body": "={{ $json.html }}",
        "fromEmail": "={{ $env.SES_FROM }}",
        "toAddresses": ["={{ $json.recipient }}"],
        "additionalFields": {}
      },
      "credentials": { "aws": { "id": "loanEngAwsSes0001", "name": "Loan Engine AWS SES" } }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000009",
      "name": "Build record SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 200],
      "parameters": { "mode": "runOnceForEachItem", "jsCode": "@@code:c_build_record_sql.js" }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000010",
      "name": "Record notification",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1760, 200],
      "parameters": { "operation": "executeQuery", "query": "={{ $json.sql }}", "options": {} },
      "credentials": { "postgres": { "id": "loanEngPostgres01", "name": "Loan Engine Postgres" } }
    },
    {
      "id": "c0000000-0000-4000-8000-000000000011",
      "name": "Throttle (SES sandbox 1/s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1980, 200],
      "webhookId": "c0000000-0000-4000-8000-0000000000aa",
      "parameters": { "amount": 1, "unit": "seconds" }
    }
  ],
  "connections": {
    "From matching workflow": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Run manually (latest batch)": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Build pending SQL", "type": "main", "index": 0 }]] },
    "Build pending SQL": { "main": [[{ "node": "Fetch users to notify", "type": "main", "index": 0 }]] },
    "Fetch users to notify": { "main": [[{ "node": "Build emails", "type": "main", "index": 0 }]] },
    "Build emails": { "main": [[{ "node": "Loop over emails", "type": "main", "index": 0 }]] },
    "Loop over emails": { "main": [[], [{ "node": "Send via SES", "type": "main", "index": 0 }]] },
    "Send via SES": { "main": [[{ "node": "Build record SQL", "type": "main", "index": 0 }]] },
    "Build record SQL": { "main": [[{ "node": "Record notification", "type": "main", "index": 0 }]] },
    "Record notification": { "main": [[{ "node": "Throttle (SES sandbox 1/s)", "type": "main", "index": 0 }]] },
    "Throttle (SES sandbox 1/s)": { "main": [[{ "node": "Loop over emails", "type": "main", "index": 0 }]] }
  }
}
