{
  "id": "loanEngineWfB001",
  "name": "B · User-Loan Matching",
  "active": false,
  "settings": { "executionOrder": "v1", "errorWorkflow": "loanEngineWfE001", "timezone": "Asia/Kolkata" },
  "nodes": [
    {
      "id": "b0000000-0000-4000-8000-000000000001",
      "name": "Webhook: batch ingested",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 100],
      "webhookId": "b0000000-0000-4000-8000-0000000000aa",
      "parameters": { "httpMethod": "POST", "path": "loan-match", "responseMode": "responseNode", "options": {} }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 100],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "b2000000-0000-4000-8000-000000000001", "name": "llm_max_calls", "value": "={{ Number($env.LLM_MAX_CALLS || 20) }}", "type": "number" },
            { "id": "b2000000-0000-4000-8000-000000000002", "name": "secret_configured", "value": "={{ Boolean($env.WEBHOOK_SECRET) }}", "type": "boolean" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000003",
      "name": "Expected signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [440, 100],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ ($json.headers['x-timestamp'] ?? '') + '.' + ($json.body?.batch_id ?? '') }}",
        "dataPropertyName": "expected_signature",
        "secret": "={{ $env.WEBHOOK_SECRET }}",
        "encoding": "hex"
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000004",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 100],
      "parameters": { "jsCode": "@@code:b_verify_signature.js" }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000005",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000006",
      "name": "Reject 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 260],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.reason }) }}",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000007",
      "name": "Accept 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: true, batch_id: $json.batch_id }) }}",
        "options": { "responseCode": 202 }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000008",
      "name": "Build query SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 0],
      "parameters": { "jsCode": "@@code:b_build_query_sql.js" }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000009",
      "name": "Fetch active products",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1540, 0],
      "parameters": { "operation": "executeQuery", "query": "={{ $json.products_sql }}", "options": {} },
      "credentials": { "postgres": { "id": "loanEngPostgres01", "name": "Loan Engine Postgres" } }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000010",
      "name": "Stage 1: SQL pre-filter",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1760, 0],
      "parameters": { "operation": "executeQuery", "query": "={{ $('Build query SQL').first().json.stage1_sql }}", "options": {} },
      "credentials": { "postgres": { "id": "loanEngPostgres01", "name": "Loan Engine Postgres" } }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000011",
      "name": "Stage 2: rules & scoring",
      "type": "n8n-nodes-base.code",
