    },
    {
      "id": "b0000000-0000-4000-8000-000000000012",
      "name": "LLM cache lookup",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2200, 0],
      "parameters": { "operation": "executeQuery", "query": "={{ $json.cache_sql }}", "options": {} },
      "credentials": { "postgres": { "id": "loanEngPostgres01", "name": "Loan Engine Postgres" } }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000013",
      "name": "Stage 3a: plan LLM work",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2420, 0],
      "parameters": { "jsCode": "@@code:b_plan_llm.js" }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000014",
      "name": "Needs LLM?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2640, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b1000000-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.needs_llm }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000015",
      "name": "One item per LLM batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, -120],
      "parameters": { "jsCode": "@@code:b_explode_batches.js" }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000016",
      "name": "Gemini: judge borderline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3080, -120],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + ($env.GEMINI_MODEL || 'gemini-3.5-flash-lite') + ':generateContent' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.gemini_request) }}",
        "options": { "timeout": 120000, "batching": { "batch": { "batchSize": 1, "batchInterval": 7000 } } }
      },
      "credentials": { "httpHeaderAuth": { "id": "loanEngGemini0001", "name": "Gemini API key" } }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000017",
      "name": "Stage 3b: apply LLM verdicts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3300, -120],
      "parameters": { "jsCode": "@@code:b_apply_llm.js" }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000018",
      "name": "Persist matches & funnel stats",
      "type": "n8n-nodes-base.postgres",
