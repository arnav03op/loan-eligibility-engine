    },
    {
      "id": "b0000000-0000-4000-8000-000000000020",
      "name": "Batch persisted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3740, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "b1000000-0000-4000-8000-000000000003",
              "leftValue": "={{ $json.batch_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000019",
      "name": "Trigger notifications (Workflow C)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [3960, -60],
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "loanEngineWfC001", "mode": "id" },
        "options": { "waitForSubWorkflow": false }
      }
    }
  ],
