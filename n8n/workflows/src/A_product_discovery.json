{
  "id": "loanEngineWfA001",
  "name": "A · Loan Product Discovery",
  "active": false,
  "settings": { "executionOrder": "v1", "errorWorkflow": "loanEngineWfE001", "timezone": "Asia/Kolkata" },
  "nodes": [
    {
      "id": "a0000000-0000-4000-8000-000000000001",
      "name": "Daily 02:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 2 * * *" }] } }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000002",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "a0000000-0000-4000-8000-000000000003",
      "name": "Sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 100],
      "parameters": { "jsCode": "@@code:a_sources.js" }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000004",
      "name": "Fetch page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "User-Agent", "value": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0 Safari/537.36" },
            { "name": "Accept-Language", "value": "en-IN,en;q=0.9" }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": { "response": { "responseFormat": "text", "outputPropertyName": "html" } }
        }
      }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000005",
      "name": "Clean & hash pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 100],
      "parameters": { "jsCode": "@@code:a_clean_and_hash.js" }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000006",
      "name": "Load crawl state",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [880, 100],
      "parameters": { "operation": "executeQuery", "query": "={{ $json.sql }}", "options": {} },
      "credentials": { "postgres": { "id": "loanEngPostgres01", "name": "Loan Engine Postgres" } }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000007",
      "name": "Plan crawl",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 100],
      "parameters": { "jsCode": "@@code:a_plan_crawl.js" }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000008",
      "name": "Changed page?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "a1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.needs_llm }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000009",
      "name": "Gemini: extract products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + ($env.GEMINI_MODEL || 'gemini-3.5-flash-lite') + ':generateContent' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.gemini_request) }}",
        "options": { "timeout": 120000, "batching": { "batch": { "batchSize": 1, "batchInterval": 7000 } } }
      },
      "credentials": { "httpHeaderAuth": { "id": "loanEngGemini0001", "name": "Gemini API key" } }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000010",
      "name": "Normalize & build upsert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 0],
      "parameters": { "jsCode": "@@code:a_page_result.js" }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000011",
      "name": "Upsert products",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1980, 0],
      "parameters": { "operation": "executeQuery", "query": "={{ $json.sql }}", "options": { "queryBatching": "independently" } },
      "credentials": { "postgres": { "id": "loanEngPostgres01", "name": "Loan Engine Postgres" } }
    },
    {
      "id": "a0000000-0000-4000-8000-000000000012",
      "name": "Record unchanged / failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1540, 220],
      "parameters": { "operation": "executeQuery", "query": "={{ $json.sql }}", "options": { "queryBatching": "independently" } },
      "credentials": { "postgres": { "id": "loanEngPostgres01", "name": "Loan Engine Postgres" } }
    }
  ],
  "connections": {
    "Daily 02:00 IST": { "main": [[{ "node": "Sources", "type": "main", "index": 0 }]] },
    "Run manually": { "main": [[{ "node": "Sources", "type": "main", "index": 0 }]] },
    "Sources": { "main": [[{ "node": "Fetch page", "type": "main", "index": 0 }]] },
    "Fetch page": { "main": [[{ "node": "Clean & hash pages", "type": "main", "index": 0 }]] },
    "Clean & hash pages": { "main": [[{ "node": "Load crawl state", "type": "main", "index": 0 }]] },
    "Load crawl state": { "main": [[{ "node": "Plan crawl", "type": "main", "index": 0 }]] },
    "Plan crawl": { "main": [[{ "node": "Changed page?", "type": "main", "index": 0 }]] },
    "Changed page?": {
      "main": [
        [{ "node": "Gemini: extract products", "type": "main", "index": 0 }],
        [{ "node": "Record unchanged / failed", "type": "main", "index": 0 }]
      ]
    },
    "Gemini: extract products": { "main": [[{ "node": "Normalize & build upsert", "type": "main", "index": 0 }]] },
    "Normalize & build upsert": { "main": [[{ "node": "Upsert products", "type": "main", "index": 0 }]] }
  }
}
